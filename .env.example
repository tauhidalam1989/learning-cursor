# # Database (Postgres)
# # Point Payload and Prisma to the same Postgres database if desired.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# # Payload secrets
# PAYLOAD_SECRET=change_this_to_a_long_random_string
# # Optional override for the server URL used to build absolute links (admin links, media)
# PAYLOAD_SERVER_URL=http://localhost:3000

# # Public site URL (used by SEO helpers / sitemap)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# # Security / cookie behavior
# # When true, middleware will enforce HTTPS for admin access and Express will
# # trust the proxy, allowing secure cookies to be set when behind a proxy.
# ENFORCE_HTTPS=false

# # Optional: If you use a provider that requires SSL for Postgres, set this to true
# # and configure your DB pool/adapter accordingly.
# DATABASE_SSL=false

# # Notes:
# # - Keep this file out of source control for real secrets. Use your deployment
# #   provider's secret management instead of committing secrets here.
# # Copy this file to `.env` and fill in your PostgreSQL connection string.
# #
# # Example:
# # DATABASE_URL="postgresql://db_user:password@localhost:5432/mydb?schema=public"

# DATABASE_URL=""

# ================================

# DATABASE (PostgreSQL)

# ================================

# Replace with your real Postgres credentials

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ================================

# PAYLOAD CMS SECURITY

# ================================

# Generate with: openssl rand -hex 32

PAYLOAD_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional override for admin/media absolute URLs

PAYLOAD_SERVER_URL=[http://localhost:3000](http://localhost:3000)

# ================================

# PUBLIC SITE URL (SEO)

# ================================

NEXT_PUBLIC_SITE_URL=[http://localhost:3000](http://localhost:3000)

# ================================

# SECURITY SETTINGS

# ================================

# Set true only in production behind HTTPS

ENFORCE_HTTPS=false

# Enable only if your Postgres provider requires SSL

DATABASE_SSL=false
